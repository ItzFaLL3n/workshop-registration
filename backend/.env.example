# Postgres connection string. If running via docker-compose.yml on the VM,
# this is overridden automatically to point at the "postgres" service —
# only fill this in for local dev without Docker.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Razorpay — OPTIONAL / currently unused.
# Online payment is disabled: registration is cash-only, collected at the desk
# on event day (Razorpay Live onboarding was declined — see HANDOFF.md
# 2026-08-30). The /webhook/razorpay route is unmounted and /register never
# creates an order, so these three are not read. Leave them blank / omit them.
# To re-enable online payment, follow "Re-enabling online payment" in HANDOFF.md
# and fill these with Live Mode values (rzp_live_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# App
# CORS origin — the site's public URL, NO trailing slash (an extra "/" breaks
# the exact-match CORS check; see WHATFIXED.md #12). In production this is the
# Cloudflare Pages URL — on the free path that's https://<project>.pages.dev,
# copied exactly from the Pages dashboard after the first deploy.
FRONTEND_URL=http://localhost:3000
WORKSHOP_FEE_RUPEES=200
# Master switch for public online registration. Leave as "true" (or unset) to
# keep it open. To CLOSE registration, set this to exactly "false" and restart
# the backend container (`docker compose up -d backend` or `docker compose
# restart backend`) — no frontend rebuild needed. The form and the homepage
# countdown pick up the change; the admin desk can still add walk-ins and
# confirm cash afterwards.
REGISTRATION_OPEN=true
ADMIN_PASSWORD=change-this-to-something-long-and-random
# Separate shared password for the on-site registration desk (check-in team).
# They can view every registration, mark a CASH one as paid, and add walk-ins
# — but can never touch a Razorpay-paid row (only the webhook can).
REGISTRATION_TEAM_PASSWORD=change-this-to-something-else-long-and-random

# Email
RESEND_API_KEY=
EMAIL_FROM=workshop@yourdomain.com

PORT=4000
NODE_ENV=development
