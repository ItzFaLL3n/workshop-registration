# Frontend env — for the Cloudflare Pages build. Set these in the Pages
# project (Settings → Environment variables), not in this repo. NEXT_PUBLIC_*
# values are inlined into the static bundle at build time, so changing one
# needs a redeploy.

# Base URL of the API on the Azure VM. No trailing slash. On the free-DNS path
# this is the VM's Azure DNS name; if you move to a bought domain later, swap in
# api.bcashc.online and Retry the Pages deployment.
NEXT_PUBLIC_API_URL=https://vortexneovia.centralindia.cloudapp.azure.com

# YouTube video/stream id for the /live page (just the id, not the full URL).
# Leave empty until the stream is set up — the page shows a "not started yet"
# state while it's blank.
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=
