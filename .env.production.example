# Copy to .env.production.local? No — docker-compose reads a file literally
# named `.env` in this directory by default. Copy this file to `.env` on the
# VM (not into git) and fill in real values before running `docker compose up -d`.

# ── Domain (used by Caddy for automatic HTTPS) ──
# Point both DOMAIN and api.DOMAIN at this VM's IP address before starting
# the stack, or Let's Encrypt cert issuance will fail.
DOMAIN=yourdomain.com

# ── Postgres (container-internal only, never exposed publicly) ──
POSTGRES_USER=workshop
POSTGRES_PASSWORD=change-this-to-something-long-and-random
POSTGRES_DB=workshop_registration

# ── Frontend build-time vars ──
# These get baked into the client JS bundle at `docker compose build` time,
# so re-run `docker compose build frontend` after changing them.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_CASHFREE_ENV=production
