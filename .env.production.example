# Copy to .env.production.local? No — docker-compose reads a file literally
# named `.env` in this directory by default. Copy this file to `.env` on the
# VM (not into git) and fill in real values before running `docker compose up -d`.
#
# Frontend is hosted separately on Cloudflare Pages (not in this compose
# stack) — this VM only runs postgres + backend + Caddy, serving the API.

# ── Domain (used by Caddy for automatic HTTPS) ──
# The hostname the API is reachable at. On the free-DNS path this is the VM's
# Azure DNS name — Caddy gets a normal Let's Encrypt cert for it (needs inbound
# port 80 open for the HTTP-01 challenge). No Cloudflare in front of the API.
# See docs/runbooks/go-live.md. If you later move to a bought domain proxied by
# Cloudflare, this becomes e.g. api.bcashc.online (runbook §11).
DOMAIN=vortexneovia.centralindia.cloudapp.azure.com

# ── Postgres (container-internal only, never exposed publicly) ──
POSTGRES_USER=workshop
POSTGRES_PASSWORD=change-this-to-something-long-and-random
POSTGRES_DB=workshop_registration
